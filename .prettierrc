{
    "parser": "babel-ts",
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 100,
    "semi": true,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "jsxBracketSameLine": true,
    "arrowParens": "avoid",
    "insertPragma": false,
    "endOfLine": "auto",
    "requirePragma": false,
    "proseWrap": "preserve",
    "htmlWhitespaceSensitivity": "css"
}
